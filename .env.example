# Supabase — Settings → API en el dashboard del proyecto.
# Copia este archivo a .env.local y llena los valores.

# Públicas: van al bundle del frontend, no son secretas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETA: bypassa RLS por completo. Nunca en el frontend, nunca en el repo.
# Se configura como secret de la Edge Function:
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=
